# ============ AI 供应商（三种模式可任意组合，见 README） ============

# 模式一：自定义 OpenAI 兼容供应商（三件套需同时配置）
# OPENCODE_CUSTOM_BASE_URL=https://api.example.com/v1
# OPENCODE_CUSTOM_API_KEY=your_api_key
# OPENCODE_CUSTOM_MODEL=your_model_id

# 模式二：DeepSeek（opencode 官方内置供应商）
# DEEPSEEK_API_KEY=your_api_key

# 模式三：Z.AI GLM Coding Plan（opencode 官方内置供应商）
ZAI_API_KEY=your_api_key

# 默认模型显式覆盖（可选，格式 provider/model，优先级最高）
# OPENCODE_MODEL=zai-coding-plan/glm-5.3

# ============ MCP 服务认证令牌（zai-mcp-server / web-search-prime / web-reader / zread） ============
GLM_MCP_TOKEN=your_mcp_token
